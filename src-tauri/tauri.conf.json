{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Allotrope",
  "version": "0.1.1",
  "identifier": "com.allotrope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Allotrope",
        "width": 1100,
        "height": 760,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#0A1A3F"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "binaries/FFMPEG-LICENSE.txt": "FFMPEG-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/menu-contextuel.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA3QkIyMjI1MjE4MkIwQ0QKUldUTnNJSWhKU0s3Qnl6ZFBXbmFkRG9XV0hPRWEzdXpaUmdTNGk1SGRhNWlvMG96TUNGV3lublUK",
      "endpoints": [
        "https://github.com/sAluTcMaNeK/allotrope/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
