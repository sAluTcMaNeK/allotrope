  !insertmacro AllotropeAjouterMenu "oga"
  !insertmacro AllotropeAjouterMenu "m4a"
  !insertmacro AllotropeAjouterMenu "aac"
  !insertmacro AllotropeAjouterMenu "opus"
  !insertmacro AllotropeAjouterMenu "wma"
  !insertmacro AllotropeAjouterMenu "aiff"
  !insertmacro AllotropeAjouterMenu "aif"
  !insertmacro AllotropeAjouterMenu "ac3"
  !insertmacro AllotropeAjouterMenu "amr"
  !insertmacro AllotropeAjouterMenu "mka"
  !insertmacro AllotropeAjouterMenu "pdf"
  !insertmacro AllotropeAjouterMenu "doc"
  !insertmacro AllotropeAjouterMenu "docx"
  !insertmacro AllotropeAjouterMenu "docm"
  !insertmacro AllotropeAjouterMenu "dot"
  !insertmacro AllotropeAjouterMenu "dotx"
  !insertmacro AllotropeAjouterMenu "odt"
  !insertmacro AllotropeAjouterMenu "ott"
  !insertmacro AllotropeAjouterMenu "rtf"
  ; Prévient l'explorateur que les associations de fichiers ont changé
  System::Call "shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)"
!macroend

