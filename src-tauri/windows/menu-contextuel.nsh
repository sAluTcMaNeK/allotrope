; Crochets de l'installateur NSIS (voir bundle.windows.nsis.installerHooks dans tauri.conf.json).
;
; Ajoute « Convertir avec Allotrope » au clic droit de l'explorateur Windows, uniquement pour les
; types de fichiers qu'Allotrope sait traiter, et le retire à la désinstallation.
; SHCTX = HKEY_CURRENT_USER pour une installation « pour moi », HKEY_LOCAL_MACHINE sinon.
;
; Liste à tenir à jour avec les extensions du code Rust : le test `menu_contextuel_a_jour`
; (ouverture.rs) le vérifie. Le « .ts » vidéo est volontairement absent (fichiers TypeScript).

!define ALLOTROPE_CLE "Software\Classes\SystemFileAssociations"

!macro AllotropeAjouterMenu EXTENSION
  WriteRegStr SHCTX "${ALLOTROPE_CLE}\.${EXTENSION}\shell\Allotrope" "MUIVerb" "Convertir avec Allotrope"
  WriteRegStr SHCTX "${ALLOTROPE_CLE}\.${EXTENSION}\shell\Allotrope" "Icon" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  ; « Player » : pas de limite de 15 fichiers sélectionnés
  WriteRegStr SHCTX "${ALLOTROPE_CLE}\.${EXTENSION}\shell\Allotrope" "MultiSelectModel" "Player"
  WriteRegStr SHCTX "${ALLOTROPE_CLE}\.${EXTENSION}\shell\Allotrope\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
!macroend

!macro AllotropeRetirerMenu EXTENSION
  DeleteRegKey SHCTX "${ALLOTROPE_CLE}\.${EXTENSION}\shell\Allotrope"
!macroend

!macro NSIS_HOOK_POSTINSTALL
  !insertmacro AllotropeAjouterMenu "jpg"
  !insertmacro AllotropeAjouterMenu "jpeg"
  !insertmacro AllotropeAjouterMenu "jfif"
  !insertmacro AllotropeAjouterMenu "jpe"
  !insertmacro AllotropeAjouterMenu "png"
  !insertmacro AllotropeAjouterMenu "apng"
  !insertmacro AllotropeAjouterMenu "webp"
  !insertmacro AllotropeAjouterMenu "bmp"
  !insertmacro AllotropeAjouterMenu "dib"
  !insertmacro AllotropeAjouterMenu "tif"
  !insertmacro AllotropeAjouterMenu "tiff"
  !insertmacro AllotropeAjouterMenu "ico"
  !insertmacro AllotropeAjouterMenu "tga"
  !insertmacro AllotropeAjouterMenu "qoi"
  !insertmacro AllotropeAjouterMenu "pbm"
  !insertmacro AllotropeAjouterMenu "pgm"
  !insertmacro AllotropeAjouterMenu "ppm"
  !insertmacro AllotropeAjouterMenu "pnm"
  !insertmacro AllotropeAjouterMenu "pam"
  !insertmacro AllotropeAjouterMenu "hdr"
  !insertmacro AllotropeAjouterMenu "exr"
  !insertmacro AllotropeAjouterMenu "dds"
  !insertmacro AllotropeAjouterMenu "ff"
  !insertmacro AllotropeAjouterMenu "svg"
  !insertmacro AllotropeAjouterMenu "svgz"
  !insertmacro AllotropeAjouterMenu "jxl"
  !insertmacro AllotropeAjouterMenu "mp4"
  !insertmacro AllotropeAjouterMenu "m4v"
  !insertmacro AllotropeAjouterMenu "mov"
  !insertmacro AllotropeAjouterMenu "mkv"
  !insertmacro AllotropeAjouterMenu "webm"
  !insertmacro AllotropeAjouterMenu "avi"
  !insertmacro AllotropeAjouterMenu "wmv"
  !insertmacro AllotropeAjouterMenu "flv"
  !insertmacro AllotropeAjouterMenu "mpg"
  !insertmacro AllotropeAjouterMenu "mpeg"
  !insertmacro AllotropeAjouterMenu "mts"
  !insertmacro AllotropeAjouterMenu "m2ts"
  !insertmacro AllotropeAjouterMenu "3gp"
